# Vorlage für die lokale Konfiguration von compose.yaml - kopieren nach ".env" und die
# Werte anpassen. ".env" selbst NICHT committen (steht deshalb in .gitignore).
#
#   cp .env.example .env

# Datenbank-Zugangsdaten für den PostgreSQL-Container (Dienst "db" in compose.yaml).
SHS_DB_USER=shs
SHS_DB_PASSWORD=bitte-hier-ein-eigenes-passwort-eintragen
SHS_DB_NAME=shs

# Signaturschlüssel für die Web-Session-Cookies (siehe app_web.py) - einmalig erzeugen mit:
#   python -c "import secrets; print(secrets.token_hex(32))"
# und das Ergebnis hier eintragen. Ohne festen Wert würde bei jedem Neustart des
# Web-Containers ein neuer Schlüssel erzeugt - alle angemeldeten Richter müssten den
# Zugangscode dann erneut eingeben.
SHS_WEB_SECRET_KEY=bitte-hier-einen-erzeugten-schluessel-eintragen

# Einrichtungs-Code für die einmalige Ersteinrichtung des ersten Administrators (siehe
# README_CONTAINER.md, Abschnitt "Benutzerkonten"). Solange noch kein Administrator
# existiert, fragt die Web-Oberfläche diesen Code zusätzlich zu Benutzername/Passwort ab
# - damit kann nicht irgendjemand im Vereinsnetz, der die Seite zufällig zuerst aufruft,
# den Administrator anlegen. Ohne gesetzten Code ist die Ersteinrichtung gesperrt.
# Einmalig erzeugen, z. B. mit:
#   python -c "import secrets; print(secrets.token_urlsafe(16))"
# und nur an die Person weitergeben, die den Administrator einrichtet. Nach der
# Ersteinrichtung wird der Code nicht mehr gebraucht (bleibt aber als Pflichtwert in
# compose.yaml stehen).
SHS_ADMIN_SETUP_CODE=bitte-hier-einen-erzeugten-code-eintragen

# Optional: welches Image der Dienst "web" verwenden soll, wenn NICHT lokal gebaut wird
# (Standard: das zuletzt über GitHub Actions veröffentlichte Image, siehe
# .github/workflows/build-container.yml und README_CONTAINER.md). Zum Bauen aus dem
# lokalen Quellcode stattdessen "podman-compose up --build" verwenden - dieser Wert wird
# dann ignoriert.
# SHS_WEB_IMAGE=ghcr.io/mbruver-source/shs-web:latest
