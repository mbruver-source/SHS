# Vorlage für die lokale Konfiguration von compose.yaml - optional kopieren nach ".env"
# und die Werte anpassen. ".env" selbst NICHT committen (steht deshalb in .gitignore).
#
#   cp .env.example .env
#
# Die Geheimnisse (Datenbank-Passwort, Session-Schlüssel, Einrichtungs-Code) stehen seit
# H-3 (05.10.2026) NICHT mehr hier, sondern als Dateien im Ordner secrets/ - siehe
# README_CONTAINER.md, Abschnitt "Geheimnisse" (Befehle zum Erzeugen, Umzug einer
# älteren .env).

# Benutzer- und Datenbankname für den PostgreSQL-Container (Dienst "db" in compose.yaml).
SHS_DB_USER=shs
SHS_DB_NAME=shs

# Optional: welches Image der Dienst "web" verwenden soll, wenn NICHT lokal gebaut wird
# (Standard: die zur compose.yaml passende Version, siehe README_CONTAINER.md, Abschnitt
# "Versionen"). Zum Bauen aus dem lokalen Quellcode stattdessen "podman-compose up --build"
# verwenden - dieser Wert wird dann ignoriert.
# SHS_WEB_IMAGE=ghcr.io/mbruver-source/shs-web:latest
