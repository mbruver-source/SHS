# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/
.eggs/

# Virtuelle Umgebungen
.venv/
venv/
env/

# PyInstaller / Inno-Setup Build-Ausgaben (werden bei jedem Build neu erzeugt,
# gehören nicht ins Repo - siehe README_INSTALLER.md)
build/
dist/
Output/
*.exe

# Editoren / IDEs (persönliche lokale Einstellungen)
.vscode/
.idea/

# Betriebssystem
.DS_Store
Thumbs.db

# Von SHS-Prüfungsprogramm zur Laufzeit angelegte Nutzerdaten - liegen ohnehin
# außerhalb dieses Ordners (%USERPROFILE%\SHS-Pruefungsprogramm\Termine), hier
# nur zur Sicherheit falls versehentlich eine Termin-Datenbank im Projektordner landet
*.sqlite3
# Termin-Dateien der Desktop-Version (enthalten Personendaten) - sollen nie versehentlich
# ins Repo gelangen (Codeprüfung 22.09., G13)
*.sqlite
# Ausnahme (T3, 03.10.2026): erfundene Termin-Dateien älterer Versionen für die
# Upgrade-Tests (test_altversionen.py), erzeugt von tools/altdaten_erzeugen.py.
!testdaten/altversionen/*/termin.sqlite

# Lokale Konfiguration für compose.yaml (Datenbank-Passwort, Session-Schlüssel) - siehe
# .env.example für die Vorlage. Enthält Geheimnisse, gehört NICHT ins Repo.
.env
# Datensicherungen der Desktop-Version (ZIP, enthalten alle Termine mit Personendaten) -
# sollen nie versehentlich ins Repo gelangen (Sicherheitsprüfung 03.10.2026, Prüfer 3)
*.zip
# Ausnahme: erfundene Testsicherungen für die Upgrade-Tests (test_altversionen.py),
# erzeugt von tools/altdaten_erzeugen.py.
!testdaten/altversionen/*/sicherung.zip
!testdaten/altversionen/*/sicherung_passwort.zip
# Noch nicht veröffentlichte Sicherheitsberichte - erst nach dem Release ins Repo
# (siehe CLAUDE.md, Abschnitt "Sicherheitsfunde erst nach dem Release veröffentlichen")
_unveroeffentlicht/
